
module seq_div_5_SV(

input logic clk,rst,d_in,
output logic detector
    );
    logic [7:0] count;
    parameter s0 = 3'b000;
    parameter s1 = 3'b001;
    parameter s2 = 3'b010;
    parameter s3 = 3'b011;
    parameter s4 = 3'b100;
    reg [2:0] ps,ns;
    
    always_ff@(posedge clk)
    begin
    if(rst) begin
    ps <= s0;
    end
    
    else begin
    ps <= ns;
    end
    
    end
    
    always_ff@(*) begin
    case(ps)
    3'b000 : ns = d_in ? s1 : s0;
    3'b001 : ns = d_in ? s3 : s2;
    3'b010 : ns = d_in ? s0 : s4;
    3'b011 : ns = d_in ? s2 : s1;
    3'b100 : ns = d_in ? s4 : s3;
    
    default : ns = s0;
    
    endcase
    end
    
    always_ff@(posedge clk) begin
    if(rst)begin
    detector <= 1'b0;
    count <= 1'b0;
    end
    else begin
  detector <= (ns == s0);
  if(ns == s0)
    count <= count + 1'b1;
    
    end
    end
    
    
    
endmodule


