
module SV_design_logic(

    input logic clk,
    input logic rst,
    input logic event01,
    output logic data_out
);

    logic captured; // remembers if first event already happened

    always_ff@(posedge clk) begin
        if (rst) begin
            captured <= 1'b0;
            data_out <= 1'b0;
        end
        else if (event01 && !captured) begin
            data_out <= 1'b1;   // capture first event
            captured <= 1'b1;   // lock further events
        end
        else begin
            data_out <= 1'b0;   // ignore further events
        end
    end

endmodule


